{
  "name": "tiniquiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint:tsc": "tsc --noEmit",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "build:all": "tsc && vite build --config geogame/vite.config.ts && vite build --config gomoku/vite.config.ts && vite build --config sudoku/vite.config.ts && vite build --config minesweeper/vite.config.ts && vite build --config sliding/vite.config.ts && vite build --config checkers/vite.config.ts && vite build --config mancala/vite.config.ts && vite build --config othello/vite.config.ts && vite build --config chess/vite.config.ts && vite build --config xiangqi/vite.config.ts && vite build --config go/vite.config.ts",
    "dev:geogame": "vite --config geogame/vite.config.ts",
    "build:geogame": "tsc && vite build --config geogame/vite.config.ts",
    "preview:geogame": "vite preview --config geogame/vite.config.ts",
    "dev:gomoku": "vite --config gomoku/vite.config.ts",
    "build:gomoku": "tsc && vite build --config gomoku/vite.config.ts",
    "preview:gomoku": "vite preview --config gomoku/vite.config.ts",
    "dev:sudoku": "vite --config sudoku/vite.config.ts",
    "build:sudoku": "tsc && vite build --config sudoku/vite.config.ts",
    "preview:sudoku": "vite preview --config sudoku/vite.config.ts",
    "dev:minesweeper": "vite --config minesweeper/vite.config.ts",
    "build:minesweeper": "tsc && vite build --config minesweeper/vite.config.ts",
    "preview:minesweeper": "vite preview --config minesweeper/vite.config.ts",
    "dev:sliding": "vite --config sliding/vite.config.ts",
    "build:sliding": "tsc && vite build --config sliding/vite.config.ts",
    "preview:sliding": "vite preview --config sliding/vite.config.ts",
    "dev:checkers": "vite --config checkers/vite.config.ts",
    "build:checkers": "tsc && vite build --config checkers/vite.config.ts",
    "preview:checkers": "vite preview --config checkers/vite.config.ts",
    "dev:mancala": "vite --config mancala/vite.config.ts",
    "build:mancala": "tsc && vite build --config mancala/vite.config.ts",
    "preview:mancala": "vite preview --config mancala/vite.config.ts",
    "dev:othello": "vite --config othello/vite.config.ts",
    "build:othello": "tsc && vite build --config othello/vite.config.ts",
    "preview:othello": "vite preview --config othello/vite.config.ts",
    "dev:chess": "vite --config chess/vite.config.ts",
    "build:chess": "tsc && vite build --config chess/vite.config.ts",
    "preview:chess": "vite preview --config chess/vite.config.ts",
    "dev:xiangqi": "vite --config xiangqi/vite.config.ts",
    "build:xiangqi": "tsc && vite build --config xiangqi/vite.config.ts",
    "preview:xiangqi": "vite preview --config xiangqi/vite.config.ts",
    "dev:go": "vite --config go/vite.config.ts",
    "build:go": "tsc && vite build --config go/vite.config.ts",
    "preview:go": "vite preview --config go/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.16"
  }
}
