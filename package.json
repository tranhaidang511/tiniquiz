{
  "name": "tiniquiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint:tsc": "tsc --noEmit",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "build:all": "node scripts/build-all.js && vite build",
    "cap:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "dev:geogame": "vite src/geogame",
    "build:geogame": "tsc && vite build src/geogame",
    "preview:geogame": "vite preview src/geogame",
    "dev:gomoku": "vite src/gomoku",
    "build:gomoku": "tsc && vite build src/gomoku",
    "preview:gomoku": "vite preview src/gomoku",
    "dev:sudoku": "vite src/sudoku",
    "build:sudoku": "tsc && vite build src/sudoku",
    "preview:sudoku": "vite preview src/sudoku",
    "dev:minesweeper": "vite src/minesweeper",
    "build:minesweeper": "tsc && vite build src/minesweeper",
    "preview:minesweeper": "vite preview src/minesweeper",
    "dev:sliding": "vite src/sliding",
    "build:sliding": "tsc && vite build src/sliding",
    "preview:sliding": "vite preview src/sliding",
    "dev:checkers": "vite src/checkers",
    "build:checkers": "tsc && vite build src/checkers",
    "preview:checkers": "vite preview src/checkers",
    "dev:mancala": "vite src/mancala",
    "build:mancala": "tsc && vite build src/mancala",
    "preview:mancala": "vite preview src/mancala",
    "dev:othello": "vite src/othello",
    "build:othello": "tsc && vite build src/othello",
    "preview:othello": "vite preview src/othello",
    "dev:chess": "vite src/chess",
    "build:chess": "tsc && vite build src/chess",
    "preview:chess": "vite preview src/chess",
    "dev:xiangqi": "vite src/xiangqi",
    "build:xiangqi": "tsc && vite build src/xiangqi",
    "preview:xiangqi": "vite preview src/xiangqi",
    "dev:go": "vite src/go",
    "build:go": "tsc && vite build src/go",
    "preview:go": "vite preview src/go"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.16"
  }
}